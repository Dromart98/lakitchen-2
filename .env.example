# Public browser configuration (Supabase publishable credentials; protected by RLS)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase administration. Required for self-service account deletion.
# Never expose this key with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only OpenAI configuration. Never expose this key with a NEXT_PUBLIC_ prefix.
OPENAI_API_KEY=
OPENAI_TEXT_MEAL_MODEL=
OPENAI_PHOTO_MEAL_MODEL=
OPENAI_DAILY_PLAN_MODEL=
OPENAI_INVENTORY_NUTRITION_MODEL=
OPENAI_RECIPE_MODEL=

# Optional server-only key for generic food nutrition lookup. Never use NEXT_PUBLIC_.
USDA_FDC_API_KEY=

# Optional private server-only model override for batch voice inventory preview.
# OPENAI_VOICE_INVENTORY_BATCH_MODEL=

# Optional private server-only model override for batch voice shopping preview.
# OPENAI_VOICE_SHOPPING_BATCH_MODEL=
